 <Border Background="#222225" BorderBrush="#46464C" BorderThickness="1" CornerRadius="12"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border x:Name="TitleBar" Background="#2D2D31" CornerRadius="12,12,0,0"><Grid Margin="20,0,14,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image x:Name="Logo" Width="34" Height="34" Margin="0,0,12,0"/><TextBlock Text="直播伴侣•参数备份管家" FontSize="20" FontWeight="Normal" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Minimize" MinHeight="0" Height="36" Content="—" Background="Transparent" BorderBrush="Transparent" Padding="12,5" Margin="0,9,5,9" AutomationProperties.Name="最小化"/><Button x:Name="CloseApp" MinHeight="0" Height="36" Content="✕" Background="Transparent" BorderBrush="Transparent" Padding="12,5" Margin="0,9,0,9" AutomationProperties.Name="关闭"/></StackPanel></Grid></Border>
  <Grid x:Name="Main" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="204"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#29292D" CornerRadius="0,0,0,12"><Grid Margin="16,26,16,24"><StackPanel><Button x:Name="NavHome" Content="参数备份" Style="{StaticResource Nav}" Foreground="#FF668E" Background="#3C3037"/><Button x:Name="NavLibrary" Content="管理备份" Style="{StaticResource Nav}"/><Button x:Name="NavTutorial" Content="使用教程" Style="{StaticResource Nav}"/><Button x:Name="NavContact" Content="联系客服" Style="{StaticResource Nav}"/><Button x:Name="NavAbout" Content="关于" Style="{StaticResource Nav}"/></StackPanel><TextBlock Text="VERSION 0.4.6" FontSize="13" Foreground="#81818B" VerticalAlignment="Bottom" Margin="12,0,0,0"/></Grid></Border>
   <Grid Grid.Column="1" Margin="32,30,32,24">
    <ScrollViewer x:Name="Home" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="参数备份" FontSize="30" FontWeight="Normal"/>
     <Border Grid.Row="1" Background="#2D2D32" CornerRadius="8" Padding="16,14" Margin="0,22,0,22"><TextBlock Text="保存或恢复前，请先退出直播伴侣" FontSize="18" Foreground="#BCBCC5"/></Border>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#2E2E33" CornerRadius="10" Padding="24,28"><StackPanel><TextBlock Text="保存当前参数" FontSize="24" FontWeight="Normal" Margin="0,0,0,30"/><Button x:Name="Save" Background="#EF3765" BorderBrush="#EF3765" Padding="16,14"><StackPanel Orientation="Horizontal"><Border x:Name="SaveGlyph" Width="25" Height="25" Background="White" Margin="0,0,12,0"/><TextBlock Text="保存参数" FontSize="20"/></StackPanel></Button></StackPanel></Border>
      <Border Grid.Column="2" Background="#2E2E33" CornerRadius="10" Padding="24,28"><StackPanel><TextBlock Text="恢复备份" FontSize="24" FontWeight="Normal" Margin="0,0,0,30"/><Button x:Name="Restore" Padding="16,14"><StackPanel Orientation="Horizontal"><Border x:Name="RestoreGlyph" Width="25" Height="25" Background="White" Margin="0,0,12,0"/><TextBlock Text="选择备份" FontSize="20"/></StackPanel></Button></StackPanel></Border>
     </Grid>

     <StackPanel Grid.Row="3" Margin="0,24,0,0"><TextBlock Text="工具箱" FontSize="22" FontWeight="Normal" Margin="0,0,0,16"/>
      <UniformGrid Rows="2" Columns="2">
       <Button x:Name="Tool0" Height="88" VerticalAlignment="Top" Margin="0,0,10,12" Padding="18,16" Background="#2E2E33" BorderBrush="#3D3D44" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal"><Image x:Name="ToolIcon0" Width="44" Height="44" Margin="0,0,16,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="采集卡改名" FontSize="19"/><TextBlock Text="修改摄像头及采集卡名称" FontSize="14" Foreground="#A5A5B0" Margin="0,6,0,0"/></StackPanel></StackPanel></Button>
       <Button x:Name="Tool1" Height="88" VerticalAlignment="Top" Margin="10,0,0,12" Padding="18,16" Background="#2E2E33" BorderBrush="#3D3D44" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal"><Image x:Name="ToolIcon1" Width="44" Height="44" Margin="0,0,16,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="OBS 改名" FontSize="19"/><TextBlock Text="修改 OBS 虚拟摄像头名称" FontSize="14" Foreground="#A5A5B0" Margin="0,6,0,0"/></StackPanel></StackPanel></Button>
       <Button x:Name="Tool2" Height="88" VerticalAlignment="Top" Margin="0,0,10,0" Padding="18,16" Background="#2E2E33" BorderBrush="#3D3D44" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal"><Image x:Name="ToolIcon2" Width="44" Height="44" Margin="0,0,16,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="OBS 蒙版" FontSize="19"/><TextBlock Text="安装高级蒙版插件" FontSize="14" Foreground="#A5A5B0" Margin="0,6,0,0"/></StackPanel></StackPanel></Button>
       <Button x:Name="Tool3" Height="88" VerticalAlignment="Top" Margin="10,0,0,0" Padding="18,16" Background="#2E2E33" BorderBrush="#3D3D44" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal"><Image x:Name="ToolIcon3" Width="44" Height="44" Margin="0,0,16,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="虚拟显示器" FontSize="19"/><TextBlock Text="安装虚拟显示器驱动" FontSize="14" Foreground="#A5A5B0" Margin="0,6,0,0"/></StackPanel></StackPanel></Button>
      </UniformGrid>
     </StackPanel>
    </Grid></ScrollViewer>
    <Grid x:Name="Library" Visibility="Collapsed"/>
    <ScrollViewer x:Name="Tutorial" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,16,0">
     <TextBlock Text="本机备份与恢复教程" FontSize="30" Margin="0,0,0,16"/>
     <TextBlock Style="{StaticResource Paragraph}" Text="调试完成后保存一份参数。以后画面或声音被改动时，在同一台电脑上选择备份恢复。以下截图使用示例名称与目录，实际位置以您选择的文件夹为准。"/>
     <TextBlock Text="1. 调好参数，正常退出直播伴侣" FontSize="22"/>
     <TextBlock Style="{StaticResource Paragraph}" Text="先在直播伴侣中确认输入设备、画面、编码、音频、美颜和调色都已调好，再正常退出。保存和恢复时都应先关闭直播伴侣，避免运行中的设置被重新写回。"/>
     <TextBlock Text="2. 在主页点击「保存参数」" FontSize="22"/>
     <TextBlock Style="{StaticResource Paragraph}" Text="打开「参数备份」，点击左侧卡片中的「保存参数」。如果提示直播伴侣仍在运行，请先退出伴侣再重试。"/>
     <Border Background="#2D2D32" BorderBrush="#414147" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,28"><Image x:Name="GuideHome" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Border>
     <TextBlock Text="3. 填写名称，保存这次调试结果" FontSize="22"/>
     <TextBlock Style="{StaticResource Paragraph}" Text="给备份起一个容易辨认的名字，例如「直播间调试完成」，再点击右下角「保存」。默认归档到软件的备份文件夹；如需另存，点击「切换目录」选择文件夹。看到「参数已保存」即表示完成。"/>
     <Border Background="#2D2D32" BorderBrush="#414147" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,28"><Image x:Name="GuideSave" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Border>
     <TextBlock Text="4. 需要还原时，选择备份并恢复" FontSize="22"/>
     <TextBlock Style="{StaticResource Paragraph}" Text="先正常退出直播伴侣，再打开左侧「管理备份」。单击要使用的备份，核对名称和备份时间，然后点击右下角「恢复备份」。您也可以从主页的「选择备份」进入恢复操作。"/>
     <Border Background="#2D2D32" BorderBrush="#414147" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,28"><Image x:Name="GuideLibrary" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Border>
     <TextBlock Text="5. 恢复完成后，启动直播伴侣" FontSize="22"/>
     <TextBlock Style="{StaticResource Paragraph}" Text="看到「参数已恢复」后，可直接点击「启动直播伴侣」，也可以关闭提示稍后启动。进入伴侣后检查输入、画面、声音、美颜和调色是否符合预期。"/>
     <Image x:Name="GuideRestored" Width="400" MaxWidth="700" HorizontalAlignment="Left" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,28"/>
     <TextBlock Text="日常管理" FontSize="22"/>
     <TextBlock Style="{StaticResource Paragraph}" Text="「切换目录」可通过 Windows 窗口选择备份所在文件夹；「打开文件夹」可查看当前目录。删除时先选中备份，再点击底部「删除备份」，确认后才会执行。建议保留一份调试完成的常用备份，新的调试结果另取名称保存。"/>
     <TextBlock Text="素材与工具箱" FontSize="22"/>
     <TextBlock Style="{StaticResource Paragraph}" Text="备份包含伴侣参数及引用的 LUT；图片、视频、音频仍使用原文件位置，请保留这些素材。相机本体上的曝光等硬件设置需在设备上调整。主页工具箱可打开改名工具；需要安装的插件或驱动会进入各自的安装流程。"/>
    </StackPanel></ScrollViewer>
    <Grid x:Name="Contact" Visibility="Collapsed"><StackPanel><TextBlock Text="联系客服" FontSize="30" FontWeight="Normal"/><TextBlock Text="微信扫一扫，联系客服" FontSize="20" Foreground="#B6B6C0" Margin="0,18,0,28"/><Border Background="White" Padding="18" CornerRadius="12" Width="344" HorizontalAlignment="Left"><Image x:Name="CustomerQr" Width="308" Height="308" Stretch="Uniform"/></Border><TextBlock Text="直播间搭建调试 · 设备采购咨询" FontSize="20" Foreground="#B6B6C0" Margin="0,26,0,0"/></StackPanel></Grid>
    <ScrollViewer x:Name="About" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,16,0">
     <TextBlock Text="关于直播伴侣备份管家" FontSize="30" Margin="0,0,0,24"/>
     <TextBlock Text="软件用途与免费声明" FontSize="23"/>
     <TextBlock Style="{StaticResource Paragraph}" Text="直播伴侣备份管家是独立开发的非营利免费辅助工具，主要用于用户在本机保存调试完成后的参数，并在需要时恢复已保存的备份。本软件不收取软件授权费用，不提供直播平台账号、流量、交易或付费权益服务。"/>
     <TextBlock Text="与官方的关系" FontSize="23"/>
     <TextBlock Style="{StaticResource Paragraph}" Text="本软件不隶属于抖音、直播伴侣或其他第三方官方，不代表官方，也不暗示已获得官方授权、认证、合作或背书。相关名称仅用于说明适用对象与功能，不用于冒充官方产品。抖音、直播伴侣、OBS 等名称、商标、图标及软件权益归各自权利人所有。"/>
     <TextBlock Text="知识产权与第三方内容" FontSize="23"/>
     <TextBlock Style="{StaticResource Paragraph}" Text="本软件尊重著作权、商标权及其他合法权益，不主张拥有第三方软件、图标、预设或素材的权益，不分发直播伴侣主程序，也不绕过账号登录、平台权限或收费限制。工具箱内的第三方程序保留其原有名称与图标，其版权、许可、安装条件及使用要求以原作者说明为准；收录不代表与原作者存在合作或背书关系。"/>
     <TextBlock Text="备份内容与本地数据" FontSize="23"/>
     <TextBlock Style="{StaticResource Paragraph}" Text="主程序的参数备份与恢复在本地进行，不会自动将备份上传至云端。备份中可能包含设备名称、文件路径与用户设置，请自行保管并谨慎分享。图片、视频和音频素材沿用原位置，移动或删除原文件可能导致素材无法调用。卸载主管家时保留的数据和备份，也需由用户自行管理。第三方工具的联网或数据行为以其自身说明为准。"/>
     <TextBlock Text="使用前提与效果说明" FontSize="23"/>
     <TextBlock Style="{StaticResource Paragraph}" Text="请仅备份和使用您有权管理的参数、预设与素材。保存或恢复前，应正常退出直播伴侣；需要保留当前状态时，请主动保存一份备份。恢复会写入所选备份中的参数，删除备份需要确认，请核对名称后操作。相机本体上的曝光等硬件设置不属于本软件的备份范围。"/>
     <TextBlock Style="{StaticResource Paragraph}" Text="当前重点支持本机参数恢复。直播伴侣更新、设备驱动变化或资源缺失可能影响恢复结果；跨电脑迁移仍在完善中，暂不承诺不同电脑能够获得完全一致的效果。第三方插件或驱动应按其安装向导和兼容性要求使用。"/>
     <TextBlock Text="责任与反馈" FontSize="23"/>
     <TextBlock Style="{StaticResource Paragraph}" Text="开发者会持续改进兼容性与稳定性，但不承诺软件适用于所有设备、版本或使用场景。请在正式使用前核对恢复结果，并妥善保留重要备份。本声明不构成法律合规鉴定，也不排除依法应承担的责任。发现功能异常或内容错误，可通过「联系客服」反馈。"/>
     <TextBlock Text="侵权反馈与删除" FontSize="23"/>
     <TextBlock Style="{StaticResource Paragraph}" Text="如果本软件展示的名称、图片、图标、文字或收录的第三方工具存在侵权问题，请通过左侧「联系客服」联系我们删除。请提供相关内容位置、权属证明和联系信息；我们将在收到反馈后核实，并及时删除、下架或调整相关内容。"/>
     <TextBlock Text="Create by @Gassy,@EktarTee" FontSize="18" Foreground="#A8A8B2" TextAlignment="Center" HorizontalAlignment="Stretch" Margin="0,72,0,24"/>
    </StackPanel></ScrollViewer>
